extends layout

block head
    link(rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="")
    script(src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" defer)

block content
    div#RideLayout
        div#RideMap

        div#RidePanel
            div#RideList
                //- div#RideListHeader
                //-     span.panel-section-title Available Rideshares
                //-     span#RideListMeta.panel-section-meta #{rideshares.length} available

                div#RideSearch
                    i.fa-solid.fa-magnifying-glass
                    input#RideSearchInput(type="text" placeholder="Search…" autocomplete="off")
                    button#RideSearchClear(title="Clear search" hidden)
                        i.fa-solid.fa-xmark

                div.ride-card-list
                    each ride in rideshares
                        -
                            const stops = [{name: ride.start_placeName, coords: [ride.start_latitude, ride.start_longitude], time: "09:00"},{name: ride.end_placeName, coords: [ride.end_latitude, ride.end_longitude], time: "09:00"}];

                        div.ride-card(data-id=ride.driverID data-search-text=([ride.start_placeName, ride.end_placeName, ride.userName].concat(stops.map(s => s.name)).join(" ").toLowerCase()))
                                    div.ride-card-info
                                        div.ride-card-route
                                            span.ride-from= ride.start_placeName
                                                i.fa-solid.fa-chevron-right
                                                span.ride-to= ride.end_placeName
                                        div.ride-card-details
                                                span.ride-driver
                                                i.fa-solid.fa-user
                                                |  #{ride.userName}
                                                span.ride-time
                                                i.fa-regular.fa-clock
                                                |  #{ride.start_time}
                                        div.ride-card-seats
                                            span.seats-num= 1
                                            span.seats-lbl= "seat"
                                            div#NoResults(hidden)
                                            i.fa-solid.fa-circle-exclamation
                                            span No rideshares match your search.
                                            
                                    div#ActiveRide
                                        //- div#ActiveDriver
                                            //- p#ActiveDriverName Mr Bean
                                            //- p#ActiveDriverCar
                                            //-     span#ActiveDriverCarModel 1977 British Leyland Mini 1000
                                            //-     span#ActiveDriverCarReg SLW 287R
                                        p.detail-loc-label Pickup
                                        p#ActivePickup Somewhere in 3 mins (9:00)

                                    div#RideDetail(style="display:none")
                                        div#RideDetailBar
                                            button#BackToListBtn(title="Back to rideshares")
                                                i.fa-solid.fa-arrow-left

                                    div#RideDetailInfo
                                        div.ride-detail-heading
                                            span.detail-driver-label Driver
                                            span#DetailDriverName
                                            span#DetailDriverCar
                                        div.detail-loc-row
                                            div.detail-loc-text
                                                span.detail-loc-label From
                                                span#DetailFrom
                                            div.detail-loc-text
                                                span.detail-loc-label To
                                                span#DetailTo
                                        div.detail-meta-row
                                            span.detail-meta-item
                                                i.fa-regular.fa-clock
                                                span#DetailTime
                                            span.detail-meta-item
                                                i.fa-solid.fa-users
                                                span#DetailSeats

                                    div#RideStops
                                        div#StopList.stop-list

                                    div#RegisterBar
                                        label Pickup
                                        select#RegisterPickup
                                        label Dropoff
                                        select#RegisterDropoff
                                        button#RegisterBtn
                                            i.fa-solid.fa-user-plus
                                            span  JOIN
   
       
    script.
        const RIDESHARES = !{JSON.stringify(rideshares)};
