extends layout

block append head
    link(rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css")
    script(src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js")

block content
    div#DriverRoutesLayout
        div#DriverRoutesList
            div#DriverRoutesHeader
                span Your routes
                a.new-route-btn(href="/driver/create_route")
                    i.fa-solid.fa-plus
                    |  New route

            if routes && routes.length
                div#RouteListItems
                    each route in routes
                        div.route-card(data-id=route.id data-start=route.start_location data-end=route.end_location)
                            div.rc-route
                                span.rc-from= route.start_location
                                i.fa-solid.fa-chevron-right
                                span.rc-to= route.end_location
                            div.rc-meta
                                span.rc-pill
                                    i.fa-regular.fa-clock
                                    |  #{route.start_time}
                                span.rc-pill
                                    i.fa-solid.fa-map-pin
                                    |  #{route.stops ? route.stops.length : 0} stop#{route.stops && route.stops.length === 1 ? '' : 's'}
                                div.rc-seats
                                    span.rc-seats-n= route.seats
                                    span.rc-seats-l seats
            else
                div#NoRoutes
                    i.fa-solid.fa-route
                    p You haven't created any routes yet.
                    a(href="/driver/create_route") Create your first route

        div#DriverRoutesMap
            div#Map
