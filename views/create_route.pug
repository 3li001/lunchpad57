extends layout

block append head
    link(rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css")
    script(src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js")

block content
    div#CreateRouteLayout
        div#CreateRouteForm
            h2.form-section-title Create a route
            form#form(action="/driver/create_route" method="POST")
                div.field-row
                    div.field
                        label(for="Start Location") Start location
                        select#start Start
                            option(value="") Select Nearest Start Destination
                        label(for="EndLocation") End location
                        select#end End
                            option(value="") Select Start Location First
                div.field
                    label(for="StartTime") Start time
                    input#StartTime(type="time" name="start_time" value="09:00" required)
                div.field
                    label(for="Seats") Available seats
                    input#Seats(type="number" name="seats" min="1" max="8" placeholder="e.g. 3" required)
                div.form-actions
                    button#submit(type="submit") Create route

        div#CreateRouteMap
            div#Map
