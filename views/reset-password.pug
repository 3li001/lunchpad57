extends layout

block content
    div.auth-page-wrapper
        div#LoginPanel.modal-panel.shadow
            div.modal-tabs
                button.selected Reset Password
            div.modal-content
                form#ResetPasswordForm(action="/auth/reset-password" method="POST")
                    input(type="hidden" name="email" value=email)
                    div.form-body
                        p.modal-text(style="padding: 0 0 1em 0;") Resetting password for: 
                            strong #{email}            
                        
                        div.form-input
                            label(for="token") Verification Code
                            input(type="text", name="token" required placeholder="Enter code from outbox")

                        div.form-input
                            label(for="password") New Password
                            input(type="password", name="password" required placeholder="••••••")
                            
                            label(for="confirmPassword") Confirm New Password
                            input(type="password", name="confirmPassword" required placeholder="••••••")                
                    div.form-actions
                        input(type="submit", value="Update Password")
    script.
        document.getElementById('ResetPasswordForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData.entries());
            try {
                const res = await fetch('/auth/reset-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                if (res.ok) {
                    window.location.href = "/auth/login";
                } else {
                    if (typeof TOAST_MANAGER !== 'undefined') {
                        TOAST_MANAGER.notifySmall(result.message);
                    } else {
                        alert(result.message);
                    }
                }
            } catch (err) {
                console.error("Connection error:", err);
            }
        });