extends layout

block content
    div.auth-page-wrapper
        div#RegisterDriverPanel.modal-panel.shadow(style="width: 480px")
            div.modal-tabs
                button.selected Register as Driver
            div.modal-content
                form#RegisterDriverForm
                    div.section-title Vehicle Details
                    div.form-input
                        label(for="make") Make
                        input#make(type="text" name="make" placeholder="e.g. Toyota" required)
                        label(for="model") Model
                        input#model(type="text" name="model" placeholder="e.g. Corolla" required)
                        label(for="year") Year
                        input#year(type="number" name="year" placeholder="e.g. 2020" min="1900" required)
                        label(for="mpg") MPG
                        input#mpg(type="number" name="mpg" placeholder="e.g. 35" min="1" max="200" required)
                    div.section-title(style="margin-top: 1em") License Plate
                    div.form-input
                        label(for="numberPlate") Number Plate
                        input#numberPlate(type="text" name="numberPlate" placeholder="e.g. ABC1234" maxlength="8" required)
                    div.form-actions
                        input(type="submit" value="Register as Driver")
                        a(href="/") Cancel
