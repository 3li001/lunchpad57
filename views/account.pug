extends layout

mixin fieldRow(id, label, value, type)
    div.field-row(id=id)
        span.field-label #{label}
        span.field-value #{value}
        button.edit-btn(onclick=`editField('${id}', '${label}', '${value}', '${type || 'text'}')`) Edit

mixin notifToggle(key, label, desc, checked)
    div.notif-row
        div
            div.notif-label #{label}
            div.notif-desc #{desc}
        label.toggle
            input(type="checkbox" data-pref=key checked=checked)
            span.toggle-track
            span.toggle-thumb

mixin notifSelect(key, label, desc, value)
    div.notif-row
        div
            div.notif-label #{label}
            div.notif-desc #{desc}
        select.notif-select(data-pref=key)
            each n in [1,2,3,5,7,10,14]
                option(value=n selected=(n === value)) #{n} day#{n === 1 ? '' : 's'}

block content
    - const prefs = user.getPrefs ? user.getPrefs() : {}
    div#Account
        div#AccountHeader
            div.account-avatar
                i.fa-solid.fa-user
            div.account-header-info
                div.account-name #{user.userName}
                div.account-email #{user.email}
                if driver
                    span.role-badge.role-badge--driver
                        i.fa-solid.fa-car
                        |  Driver
                else
                    span.role-badge.role-badge--user
                        i.fa-solid.fa-person
                        |  Passenger

        div.account-tabs
            button.account-tab.active(data-tab="ProfilePane") Profile
            button.account-tab(data-tab="DriverPane") Driver
            button.account-tab(data-tab="SecurityPane") Security

        div#ProfilePane.tab-pane.active
            div.content-section
                div.section-title Personal Details
                +fieldRow('field-name', 'Name', user.userName)
                +fieldRow('field-email', 'Email', user.email, 'email')

        div#DriverPane.tab-pane
            if driver
                div.content-section
                    div.section-title Driver Status
                    div.driver-status-card
                        div.driver-status-icon
                            i.fa-solid.fa-car.fa-2x
                        div.driver-status-info
                            div.driver-status-title You are registered as a driver
                            div.driver-status-sub #{driver.completedRides} completed ride#{driver.completedRides === 1 ? '' : 's'}
                div.content-section
                    div.section-title Your Vehicle
                    div.field-row
                        span.field-label Make
                        span.field-value #{driver.vehicleMake}
                    div.field-row
                        span.field-label Model
                        span.field-value #{driver.vehicleModel}
                    div.field-row
                        span.field-label Year
                        span.field-value #{driver.vehicleYear}
                    div.field-row
                        span.field-label MPG
                        span.field-value #{driver.mpg}
                    div.field-row
                        span.field-label Number Plate
                        span.field-value #{driver.numberplate}
            else
                div.content-section
                    div.driver-cta
                        div.driver-cta-icon
                            i.fa-solid.fa-car.fa-2x
                        div.driver-cta-text
                            div.driver-cta-title Not registered as a driver
                            div.driver-cta-sub Want to offer rides? Register your vehicle and start driving.
                        a.btn.btn-primary(href="/driver/register") Become a Driver

        div#SecurityPane.tab-pane
            div.content-section
                div.section-title Change Password
                div.field-row.editing
                    span.field-label Current
                    span.field-value: input(type="password" placeholder="Current password")
                div.field-row.editing
                    span.field-label New password
                    span.field-value: input(type="password" placeholder="New password")
                div.field-row.editing
                    span.field-label Confirm
                    span.field-value: input(type="password" placeholder="Confirm new password")
                div.action-row
                    button.btn.btn-primary(onclick="changePassword()") Update Password
            div.content-section.danger-zone
                div.section-title Danger Zone
                div.field-row
                    span.field-value Permanently delete your account and all associated data.
                    button.btn.btn-danger(onclick="deleteAccount()") Delete Account
