extends layout

mixin fieldRow(id, label, value, type)
    div.field-row(id=id)
        span.field-label #{label}
        span.field-value #{value}
        button.edit-btn(onclick=`editField('${id}', '${label}', '${value}', '${type || 'text'}')`) Edit

mixin notifToggle(key, label, desc, checked)
    div.notif-row
        div
            div.notif-label #{label}
            div.notif-desc #{desc}
        label.toggle
            input(type="checkbox" data-pref=key checked=checked)
            span.toggle-track
            span.toggle-thumb

mixin notifSelect(key, label, desc, value)
    div.notif-row
        div
            div.notif-label #{label}
            div.notif-desc #{desc}
        select.notif-select(data-pref=key)
            each n in [1,2,3,5,7,10,14]
                option(value=n selected=(n === value)) #{n} day#{n === 1 ? '' : 's'}

block content
    - const prefs = user.getPrefs()
    div#Account
        div#AccountHeader
            div.account-name #{user.getName()}
            div.account-email #{user.getEmail()}

        div.account-tabs
            button.account-tab.active(data-tab="ProfilePane") Profile
            button.account-tab(data-tab="NotificationsPane") Notifications
            button.account-tab(data-tab="SecurityPane") Security

        div#ProfilePane.tab-pane.active
            div.content-section
                div.section-title Personal details
                +fieldRow('field-name', 'Name', user.getName())
                +fieldRow('field-email', 'Email', user.getEmail(), 'email')

        div#NotificationsPane.tab-pane
            div.content-section
                div.section-title Email reminders
                p.notif-info
                    | We'll email #{user.getEmail()} when something needs your attention. Reminders only go out when a deadline is inside your warning window, and we won't send the same reminder twice in one day.

                +notifToggle('autoEmailNotifications', 'Auto email reminders', 'Master switch for all reminder emails.', prefs.autoEmailNotifications)
                +notifSelect('reminderDays', 'Deadline warning window', 'Only remind me when something is this close to its deadline.', prefs.reminderDays)
                +notifSelect('activityLogDays', 'Activity log gap', "Remind me if I haven't logged progress on a task for this many days.", prefs.activityLogDays)
                +notifToggle('notifyUpcoming', 'Upcoming assessments', 'When an assessment is due soon.', prefs.notifyUpcoming)
                +notifToggle('notifyMilestones', 'Upcoming milestones', 'When a milestone is due soon.', prefs.notifyMilestones)
                +notifToggle('notifyActivityLog', 'Activity logging reminders', "When I haven't logged progress in a while.", prefs.notifyActivityLog)
                +notifToggle('notifyMissed', 'Missed deadlines', "If a deadline has passed and stuff is still unfinished.", prefs.notifyMissed)

                div.notif-save-state#NotificationSaveState Saved automatically

            div.content-section
                div.section-title Current reminders
                p.notif-info Things that would trigger an email right now.
                div#NotificationPreview.notif-preview Loading...

        div#SecurityPane.tab-pane
            div.content-section
                div.section-title Change password
                div.field-row.editing
                    span.field-label Current
                    span.field-value: input(type="password" placeholder="Current password")
                div.field-row.editing
                    span.field-label New password
                    span.field-value: input(type="password" placeholder="New password")
                div.field-row.editing
                    span.field-label Confirm
                    span.field-value: input(type="password" placeholder="Confirm new password")
                div.action-row
                    button.btn.btn-primary(onclick="changePassword()") Update password
            div.content-section.danger-zone
                div.section-title Danger zone
                div.field-row
                    span.field-value Permanently delete your account and all associated data.
                    button.btn.btn-danger(onclick="deleteAccount()") Delete account
